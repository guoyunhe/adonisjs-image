import { defineConfig } from 'adonisjs-image'

const imageConfig = defineConfig({
  default: 'image',
  presets: {
    image: {
      /** Drive disk (defaults to the Drive default disk) */
      // disk: 'fs',
      directory: 'images',

      /** Convert all uploads to one format */
      // convertTo: 'webp',

      /** Downscale (never enlarge) originals */
      maxWidth: 2560,
      maxHeight: 2560,
      stripMetadata: true,
      quality: { jpeg: 80, webp: 80, avif: 50, png: 90 },

      /** Thumbnails generated for each upload */
      thumbnails: {
        large: { width: 1280, height: 1280, fit: 'inside', format: 'webp', quality: 80 },
        medium: { width: 640, height: 640, fit: 'inside', format: 'webp', quality: 80 },
        small: { width: 320, height: 320, fit: 'cover', format: 'webp', quality: 80 },
      },
    },
    avatar: {
      directory: 'avatars',
      maxWidth: 512,
      maxHeight: 512,
      fit: 'cover',
      convertTo: 'webp',
      thumbnails: {
        large: { width: 256, height: 256, fit: 'cover', format: 'webp' },
        medium: { width: 128, height: 128, fit: 'cover', format: 'webp' },
        small: { width: 64, height: 64, fit: 'cover', format: 'webp' },
      },
    },
    photo: {
      directory: 'photos',
      maxWidth: 6000,
      maxHeight: 6000,
      quality: { jpeg: 95, webp: 90, avif: 80, png: 100, tiff: 95 },
    },
  },
})

export default imageConfig
