import { defineConfig } from 'adonisjs-image'

const imageConfig = defineConfig({
  default: 'image',
  presets: {
    image: {
      /** Drive disk (defaults to the Drive default disk) */
      // disk: 'fs',
      directory: 'images',
      maxWidth: 2560,
      maxHeight: 2560,
      convertTo: 'webp',
      quality: 80,

      thumbnails: {
        large: { width: 1280, height: 1280, format: 'webp' },
        medium: { width: 640, height: 640, format: 'webp' },
        small: { width: 320, height: 320, fit: 'cover', format: 'webp' },
      },
    },
    avatar: {
      directory: 'avatars',
      maxWidth: 512,
      maxHeight: 512,
      fit: 'cover',
      convertTo: 'webp',

      thumbnails: {
        large: { width: 256, height: 256, fit: 'cover', format: 'webp' },
        medium: { width: 128, height: 128, fit: 'cover', format: 'webp' },
        small: { width: 64, height: 64, fit: 'cover', format: 'webp' },
      },
    },
    photo: {
      directory: 'photos',
      maxWidth: 6000,
      maxHeight: 6000,
      /** Preserve EXIF metadata. May expose private information. Avoid for publicly accessible images. */
      keepMetadata: true,
      quality: { jpeg: 95, webp: 90, avif: 80, png: 100, tiff: 95 },

      thumbnails: {
        large: { width: 1280, height: 1280, format: 'webp' },
        medium: { width: 640, height: 640, format: 'webp' },
        small: { width: 320, height: 320, fit: 'cover', format: 'webp' },
      },
    },
  },
})

export default imageConfig
