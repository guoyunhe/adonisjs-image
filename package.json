{
  "name": "adonisjs-image",
  "version": "0.1.1",
  "description": "Image upload, processing and management for AdonisJS",
  "license": "MIT",
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./services/main": "./build/services/main.js",
    "./image_provider": "./build/providers/image_provider.js"
  },
  "scripts": {
    "build": "rm -r build && tsc && cp -R stubs build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "tsx --test tests/*.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "isomorphic-dompurify": "^2.26.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.11.2"
    }
  }
}
