{
  "name": "adonisjs-image",
  "version": "0.3.1",
  "description": "Image uploads, processing, storage, and Lucid ORM integration for AdonisJS.",
  "keywords": [
    "adonisjs",
    "drive",
    "image",
    "image-processing",
    "image-upload",
    "lucid",
    "sharp",
    "svg"
  ],
  "homepage": "https://github.com/guoyunhe/adonisjs-image#readme",
  "bugs": {
    "url": "https://github.com/guoyunhe/adonisjs-image/issues"
  },
  "license": "AGPL-3.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://github.com/guoyunhe"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guoyunhe/adonisjs-image.git"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./services/main": "./build/services/main.js",
    "./image_provider": "./build/providers/image_provider.js"
  },
  "scripts": {
    "build": "rm -r build && tsc && cp -R stubs build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "tsx --test tests/*.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "isomorphic-dompurify": "^2.26.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.11.2"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
